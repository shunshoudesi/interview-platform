# 统一换行符，避免 Windows 与 macOS/Linux 协作时整文件 diff
* text=auto eol=lf

# Shell 与 Gradle 包装脚本使用 LF
gradlew         text eol=lf
*.sh            text eol=lf

# Windows 脚本使用 CRLF
*.bat           text eol=crlf

# 二进制文件不做换行符转换
*.jar           binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.zip           binary